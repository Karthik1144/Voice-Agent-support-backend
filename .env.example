# Copy this file to .env and fill in real values.
# .env is gitignored - never commit your actual .env file.

# Postgres
DB_NAME=support
DB_USERNAME=postgres
DB_PASSWORD=change_me_locally

# Full JDBC URL - only override if not using the default docker-compose setup
DB_URL=jdbc:postgresql://localhost:5432/support

# Bearer token required on all /api/** routes. Must match the value
# configured in the ElevenAgents webhook tool headers.
# Generate one with: openssl rand -hex 24
WEBHOOK_SECRET=change_me_generate_a_new_one
